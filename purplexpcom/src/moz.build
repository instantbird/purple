# file, You can obtain one at http://mozilla.org/MPL/2.0/.

XPCSHELL_TESTS_MANIFESTS += ['test/xpcshell.ini']

SOURCES += [
    'purpleAccount.cpp',
    'purpleAccountBuddy.cpp',
    'purpleAccountScoper.cpp',
    'purpleConvChat.cpp',
    'purpleConvChatBuddy.cpp',
    'purpleConversation.cpp',
    'purpleConvIM.cpp',
    'purpleCoreService.cpp',
    'purpleDebug.cpp',
    'purpleDNS.cpp',
    'purpleGetText.cpp',
    'purpleGListEnumerator.cpp',
    'purpleInit.cpp',
    'purpleInitAccounts.cpp',
    'purpleInitCommands.cpp',
    'purpleInitContacts.cpp',
    'purpleInitConv.cpp',
    'purpleMessage.cpp',
    'purpleModule.cpp',
    'purpleNetwork.cpp',
    'purplePref.cpp',
    'purpleProtocol.cpp',
    'purpleProxy.cpp',
    'purpleProxyInfo.cpp',
    'purpleSockets.cpp',
    'purpleTimer.cpp',
    'purpleTooltipInfo.cpp',
]

if CONFIG['OS_ARCH'] == 'WINNT' or CONFIG['OS_ARCH'] == 'Darwin':
    SOURCES += ['purpleMemory.cpp']

EXTRA_COMPONENTS += ['prpl.manifest']

XPCOMBinaryComponent('purplexpcom')

USE_LIBS += [
    'nss',
]

if CONFIG['OS_ARCH'] == 'WINNT':
    OS_LIBS += [
        'ws2_32',
    ]

    if CONFIG['PURPLE_BONJOUR']:
        OS_LIBS += [
            'netapi32',
        ]
elif CONFIG['OS_ARCH'] == 'Darwin':
    OS_LIBS += [
        'iconv',
        'resolv',
        'z',
    ]

    # For SIPE.
    if CONFIG['GSSAPI']:
        OS_LIBS += CONFIG['KRB5_LIBS'].split()
else:
    OS_LIBS += (CONFIG['GLIB_LIBS'] + CONFIG['GLIB_GMODULE_LIBS'] +
               CONFIG['LIBXML2_LIBS'].split() + [
        'z',
    ])

    if CONFIG['OS_ARCH'] != 'FreeBSD':
        OS_LIBS += [
            'resolv',
        ]
