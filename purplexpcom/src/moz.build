XPCSHELL_TESTS_MANIFESTS += ['test/xpcshell.ini']

prpls = ['jabber', 'gg', 'oscar', 'msn', 'myspace', 'novell',
         'qq', 'sametime', 'simple', 'yahoo', 'netsoul']

if CONFIG['PURPLE_BONJOUR']:
    prpls += ['bonjour']

if CONFIG['MOZ_DEBUG']:
    prpls += ['null']

for prpl in prpls:
    if not prpl in CONFIG['STATIC_PRPLS'].split(" "):
        PARALLEL_DIRS += ['../../libpurple/protocols/' + prpl]

SOURCES += [
    'purpleAccount.cpp',
    'purpleAccountBuddy.cpp',
    'purpleAccountScoper.cpp',
    'purpleConvChat.cpp',
    'purpleConvChatBuddy.cpp',
    'purpleConversation.cpp',
    'purpleConvIM.cpp',
    'purpleCoreService.cpp',
    'purpleDebug.cpp',
    'purpleDNS.cpp',
    'purpleGetText.cpp',
    'purpleGListEnumerator.cpp',
    'purpleInit.cpp',
    'purpleInitAccounts.cpp',
    'purpleInitCommands.cpp',
    'purpleInitContacts.cpp',
    'purpleInitConv.cpp',
    'purpleMessage.cpp',
    'purpleModule.cpp',
    'purpleNetwork.cpp',
    'purplePref.cpp',
    'purpleProtocol.cpp',
    'purpleProxy.cpp',
    'purpleProxyInfo.cpp',
    'purpleSockets.cpp',
    'purpleTimer.cpp',
    'purpleTooltipInfo.cpp',
]

if CONFIG['OS_ARCH'] == 'WINNT' or CONFIG['OS_ARCH'] == 'Darwin':
    SOURCES += ['purpleMemory.cpp']

EXTRA_COMPONENTS += ['prpl.manifest']

IS_COMPONENT = True

LIBRARY_NAME = 'purplexpcom'

FORCE_SHARED_LIB = True
