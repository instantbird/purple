DEPTH		= ../../..
topsrcdir	= @top_srcdir@
srcdir		= @srcdir@
VPATH		= @srcdir@

include $(DEPTH)/config/autoconf.mk

MODULE		= purplexpcom
LIBRARY_NAME	= purplexpcom
#EXPORT_LIBRARY	= 1
IS_COMPONENT	= 1
MODULE_NAME	= purplexpcom
#NO_DIST_INSTALL	= 1

ifneq (,$(filter-out WINNT WINCE Darwin,$(OS_ARCH)))
LOCAL_INCLUDES	= $(GLIB_CFLAGS)
EXTRA_LIBS	= $(GLIB_LIBS) -lgmodule-2.0 $(DIST)/lib/libpurple.so -lz -lxml2
else
LOCAL_INCLUDES  += -I$(DIST)/include/glib
EXTRA_LIBS	= -L$(DIST)/lib -lpurple -lz
endif

ifeq (,$(filter-out WINNT WINCE,$(OS_ARCH)))
EXTRA_LIBS	= $(DIST)/lib/purple.lib
endif

CPPSRCS		= \
		purpleAccount.cpp \
		purpleAccountBase.cpp \
		purpleAccountBuddy.cpp \
		purpleAccountsService.cpp \
		purpleConversation.cpp \
		purpleConvIM.cpp \
		purpleConvChat.cpp \
		purpleConvChatBuddy.cpp \
		purpleCoreService.cpp \
		purpleDebug.cpp \
		purpleDNS.cpp \
		purpleInit.cpp \
		purpleInitAccounts.cpp \
		purpleInitCommands.cpp \
		purpleInitContacts.cpp \
		purpleInitConv.cpp \
		purpleIdle.cpp \
		purpleGetText.cpp \
		purpleGListEnumerator.cpp \
		purpleMessage.cpp \
		purpleModule.cpp \
		purpleNetwork.cpp \
		purplePref.cpp \
		purpleProtocol.cpp \
		purpleProxy.cpp \
		purpleProxyInfo.cpp \
		purpleSockets.cpp \
		purpleStorage.cpp \
		purpleTimer.cpp \
		purpleTooltipInfo.cpp \
		purpleUnknownProtocol.cpp \
		$(NULL)

ifeq ($(OS_ARCH),Darwin)
CPPSRCS		+= nsDockTile.cpp
OS_LIBS		+= -framework Carbon
endif

ifdef PURPLE_PLUGINS
DEFINES 	+= -DPURPLE_PLUGINS
endif

EXTRA_COMPONENTS = \
		gtalkOverrideProtocol.js \
		facebookOverrideProtocol.js \
		overrideProtocols.manifest \
		twitter.js \
		twitter.manifest \
		$(NULL)

EXTRA_COMPONENTS += \
		imContacts.js imContacts.manifest \
		imCommands.js imCommands.manifest \
		$(NULL)

ifdef MOZ_DEBUG
EXTRA_COMPONENTS += jsTestProtocol.js jsTestProtocol.manifest
endif

EXTRA_JS_MODULES = \
	jsProtoHelper.jsm \
	socket.jsm \
	$(NULL)

EXTRA_DSO_LDOPTS += $(XPCOM_GLUE_LDOPTS) $(MOZ_COMPONENT_NSPR_LIBS)

include $(topsrcdir)/config/rules.mk

ifeq (,$(filter-out WINNT WINCE,$(OS_ARCH)))
CXXFLAGS	+= -wd4624 -wd4068
endif

#libs:: $(SHARED_LIBRARY)
#	$(INSTALL) $(IFLAGS2) $(SHARED_LIBRARY) $(FINAL_TARGET)/libraries
