#include "nsISupports.idl"
#include "nsISimpleEnumerator.idl"
#include "purpleIConversation.idl"
#include "purpleIAccountsService.idl"
#include "purpleIBuddy.idl"
#include "purpleITag.idl"
#include "purpleIProxy.idl"

//forward declarations
interface mozIStorageConnection;

/*
 * This is a proxy to the libpurple core
 */
[ptr] native PurpleNativeBuddy(PurpleBuddy);
[ptr] native purpleNativeProtocol(purpleProtocol);

[scriptable, uuid(b82583f1-307b-4034-b5c7-9f727fab7d8c)]
interface purpleICoreService: purpleIAccountsService {
  void init();
  void quit();
  readonly attribute AUTF8String version;

  purpleIBuddy getBuddyById(in long aId);
  [noscript] void purpleBuddyAdded(in PurpleNativeBuddy aBuddy);
  [noscript] void purpleBuddyRemoved(in PurpleNativeBuddy aBuddy);

  purpleITag createTag(in AUTF8String aName);
  purpleITag getTagById(in long aId);
  purpleITag getTagByName(in AUTF8String aName);
  void getTags([optional] out unsigned long tagCount,
               [retval, array, size_is(tagCount)] out purpleITag tags);

  nsISimpleEnumerator getConversations();
  purpleIConversation getConversationById(in unsigned long aId);

  // returns an enumerator on a purpleIProtocol array
  nsISimpleEnumerator getProtocols();

  purpleIProtocol getProtocolById(in AUTF8String aProtocolId);

  /* Create a new proxy and store it in the preferences */
  purpleIProxy createProxy(in short aType, in AUTF8String aHost, in unsigned long aPort,
                           in AUTF8String aUsername, in AUTF8String aPassword);

  /* returns an enumerator on a purpleIProxy array */
  nsISimpleEnumerator getProxies();

  /* type of the global proxy used for connecting all accounts that
     don't have specific proxy settings.
  */
  attribute purpleIProxyInfo globalProxy;

  /* This attribute is set to AUTOLOGIN_ENABLED by default. It can be set to
     any other value before the initialization of this service to prevent
     accounts with autoLogin enabled from being connected when libpurple is
     initialized.
     Any value other than the ones listed below will disable autoLogin and
     display a generic message in the Account Manager. */
  attribute short autoLoginStatus;

  const short AUTOLOGIN_ENABLED = 0;
  const short AUTOLOGIN_USER_DISABLED = 1;
  const short AUTOLOGIN_SAFE_MODE = 2;
  const short AUTOLOGIN_CRASH = 3;
  const short AUTOLOGIN_START_OFFLINE = 4;

  /* The method should be used to connect all accounts with autoLogin enabled.
     Some use cases:
       - if the autologin was disabled at startup
       - after a loss of internet connectivity that disconnected all accounts.
  */
  void processAutoLogin();

  void notifyObservers(in nsISupports aObj, in string aEvent,
                       [optional] in wstring aData);

  /* buddy related event fired:
      - buddy-added: a new buddy has been added to the buddy list
      - buddy-signed-on: this buddy has just signed on
      - buddy-signed-off: this buddy has just signed off
      - buddy-removed: this buddy has been removed from the buddy list
   */

  // FIXME: this should really go in a purpleStorage service
  readonly attribute mozIStorageConnection storageConnection;

  const short STATUS_UNSET = 0;
  const short STATUS_OFFLINE = 1;
  const short STATUS_MOBILE = 2;
  const short STATUS_INVISIBLE = 3;
  const short STATUS_IDLE = 4;
  const short STATUS_AWAY = 5;
  const short STATUS_UNAVAILABLE = 6;
  const short STATUS_AVAILABLE = 7;

  readonly attribute AUTF8String currentStatusMessage;
  readonly attribute short currentStatusType;

  // Only works with STATUS_OFFLINE, STATUS_UNAVAILABLE, STATUS_AWAY,
  // STATUS_AVAILABLE and STATUS_INVISIBLE.  When called with the
  // status type STATUS_UNSET, only the status message will be
  // changed.  When called with STATUS_OFFLINE, the aMessage parameter
  // is ignored.
  void setStatus(in short aStatus, in AUTF8String aMessage);
};
