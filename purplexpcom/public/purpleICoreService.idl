#include "nsISupports.idl"
#include "nsIArray.idl"
#include "nsISimpleEnumerator.idl"
#include "purpleIConversation.idl"
#include "purpleIAccount.idl"
#include "purpleIBuddy.idl"

/* 
 * This is the libpurple core
 */
[ptr] native purpleNativeProtocol(purpleProtocol);
[ptr] native PurpleNativeAccount(PurpleAccount);
[ptr] native PurpleNativeBuddy(PurpleBuddy);

[scriptable, uuid(b82583f1-307b-4034-b5c7-9f727fab7d8c)]
interface purpleICoreService: nsISupports {
  void init();
  void quit();
  readonly attribute string version;

  purpleIBuddy getBuddyById(in long aId);
  [noscript] purpleIBuddy getBuddyByPurpleBuddy(in PurpleNativeBuddy aBuddy);

  nsISimpleEnumerator getConversations();
  purpleIConversation getConversationById(in long aId);

  // returns an enumerator on a purpleIProtocol array
  nsISimpleEnumerator getProtocols();

  purpleIProtocol getProtocolById(in string aProtocolId);
  [noscript] purpleNativeProtocol getProtoById(in string aProtocolId);

  /* accounts */
  purpleIAccount getAccountById(in string aAccountId);
  [noscript] purpleIAccount getAccountByPurpleAccount(in PurpleNativeAccount aAccount);

  nsISimpleEnumerator getAccounts();

  /* will fire the event account-added */
  purpleIAccount createAccount(in string aName, in string aPrpl);

  /* will fire the event account-removed */
  void deleteAccount(in string aAccountId);

  [noscript] void fireAccountEvent(in PurpleNativeAccount aAccount,
				   in string aEvent);
  /* account related event fired:
      - account-added: a new account has been created
      - account-removed: the account has been deleted
      - account-signin-on: a connection is being created for the account
         This is fired when a connection is created for connecting an account,
	 but is also fired when a connection is created for registering an account.
      - account-connecting: the account is being connected
         This is not fired when registering an account
	 This event is fired *after* account-signing-on
      - account-connected: the account is now connected
      - account-disconnecting: the account is being disconnected
      - account-disconnected: the account is now disconnected

      These events can be watched using an nsIObserver.
      The associated purpleIAccount will be given as a parameter.
  */

  [noscript] void fireBuddyEvent(in PurpleNativeBuddy aBuddy,
				   in string aEvent);
  /* buddy related event fired:
      - buddy-added: a new buddy has been added to the buddy list
      - buddy-signed-on: this buddy has just signed on
      - buddy-signed-off: this buddy has just signed off
      - buddy-removed: this buddy has been removed from the buddy list
   */
};
