#include "nsISupports.idl"
#include "purpleIAccount.idl"
#include "purpleIBuddy.idl"
#include "purpleITag.idl"

/*
 * This interface provides access to the link between an account and a
 * buddy.
 */

[scriptable, uuid(5a532eea-0382-46b1-a861-78015c26acda)]
interface purpleIAccountBuddy: nsISupports {
  readonly attribute purpleIBuddy buddy;
  readonly attribute purpleIAccount account;
           attribute purpleITag tag;
  readonly attribute AUTF8String buddyName;
  readonly attribute AUTF8String buddyAlias;
  readonly attribute AUTF8String loggedIn;
  readonly attribute AUTF8String buddyIconFilename;

  // enumerator of purpleITooltipInfo components
  nsISimpleEnumerator getTooltipInfo();

  purpleIConversation createConversation();

  // True if the buddy is online or if the account supports sending
  // offline messages.
  readonly attribute boolean canSendMessage;

  readonly attribute boolean online;
  readonly attribute boolean available;
  readonly attribute boolean idle;
  readonly attribute boolean mobile;
  readonly attribute AUTF8String status;

  // enumerator of purpleILog
  // Warning: this will leak if not fully enumerated
  nsISimpleEnumerator getLogs();

  // remove the buddy from the buddy list.
  void remove();
};
