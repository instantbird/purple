ifeq (,$(filter-out WINNT WINCE,$(OS_ARCH)))
CSRCS		+= \
		win32/libc_interface.c \
		win32/win32dep.c \
		$(NULL)
endif

include $(topsrcdir)/config/rules.mk

# libs:: $(SHARED_LIBRARY)
# ifneq (,$(filter OS2 WINNT WINCE,$(OS_ARCH)))
# 	$(INSTALL) $(IFLAGS2) $(IMPORT_LIBRARY) $(DIST)/lib
# else
# 	$(INSTALL) $(IFLAGS2) $(SHARED_LIBRARY) $(DIST)/lib
# endif
# 	$(INSTALL) $(IFLAGS2) $(SHARED_LIBRARY) $(FINAL_TARGET)/libraries

export:: $(EXPORTS) $(PUBLIC)
	$(INSTALL) $(IFLAGS1) $^

purple.def: $(EXPORTS)
	echo EXPORTS > purple.def 
	(cd $(srcdir); cat $(EXPORTS)) |egrep '^[a-zA-Z].* \*?w?purple_[a-z_0-9]+\(' |sed -e 's/(.*//' -e 's/.* \*\?//' |sort |uniq >> purple.def
	(cd $(srcdir); cat $(EXPORTS)) |egrep '^w?purple_[a-z_0-9]+ ?\(' |sed -e 's/(.*//' |sort |uniq >> purple.def
	cat $(srcdir)/server.h |egrep '^[a-zA-Z].* \*?serv_[a-z_0-9]+\(' |sed -e 's/(.*//' -e 's/.* \*\?//' |sort |uniq >> purple.def
	cat $(srcdir)/signals.h |egrep 'void purple_marshal_[A-Z_]+\(' |sed -e 's/(.*//' -e 's/.* \*\?//' |sort |uniq >> purple.def
	cat $(srcdir)/xmlnode.h |egrep '^[a-zA-Z].* \*?xmlnode_[a-z_]+\(' |sed -e 's/(.*//' -e 's/.* \*\?//' |sort |uniq >> purple.def

purple.dll: purple.def

version.h: version.h.in $(DEPTH)/config/autoconf.mk
	sed 's/@''PURPLE_MAJOR_VERSION@/$(PURPLE_MAJOR_VERSION)/;s/@''PURPLE_MINOR_VERSION@/$(PURPLE_MINOR_VERSION)/;s/@''PURPLE_MICRO_VERSION@/$(PURPLE_MICRO_VERSION)/' $< > $@

module.ver: module.ver.in $(DEPTH)/config/autoconf.mk
	sed 's/@''PURPLE_MAJOR_VERSION@/$(PURPLE_MAJOR_VERSION)/;s/@''PURPLE_MINOR_VERSION@/$(PURPLE_MINOR_VERSION)/;s/@''PURPLE_MICRO_VERSION@/$(PURPLE_MICRO_VERSION)/' $< > $@

GARBAGE += purple.def version.h module.ver
