DEPTH		= @DEPTH@
topsrcdir	= @top_srcdir@
srcdir		= @srcdir@
VPATH		= @srcdir@
PROTOCOL	= gg

include $(srcdir)/../prpl.mk

LOCAL_INCLUDES	+= -I$(srcdir)/lib

include $(srcdir)/../prpl-rules.mk

export::
	mkdir -p lib
