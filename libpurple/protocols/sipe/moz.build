if CONFIG['OS_ARCH'] == 'WINNT':
    SOURCES += [
        'core/sip-sec-sspi.c',
        'core/sipe-domino.c',
        'core/sipe-win32dep.c',
    ]
elif CONFIG['GSSAPI']:
    SOURCES += ['core/sip-sec-gssapi.c']
    if not CONFIG['GSSAPI_ONLY']:
        SOURCES += [
            'core/md4.c',
            'core/sip-sec-negotiate.c',
            'core/sip-sec-ntlm.c',
        ]

if CONFIG['GSSAPI']:
    OS_LIBS += CONFIG['KRB5_LIBS'].split()

USE_LIBS += [
    'nss',
]
if not CONFIG['MOZ_FOLD_LIBS']:
    USE_LIBS += [
        'nspr',
    ]

protocol = 'sipe'

include('../prpl.py')
