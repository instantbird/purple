DEPTH		= ../../../..
topsrcdir	= @top_srcdir@
srcdir		= @srcdir@
VPATH		= @srcdir@
PROTOCOL	= jabber

include $(srcdir)/../prpl.mk

ifneq (,$(filter-out WINNT Darwin,$(OS_ARCH)))
LOCAL_INCLUDES	+= -I/usr/include/libxml2/ -I/usr/local/include/libxml2/
else
REQUIRES	+= libxml2
endif

CSRCS		= \
		auth.c \
		auth_digest_md5.c \
		auth_plain.c \
		auth_scram.c \
		buddy.c \
		bosh.c \
		chat.c \
		disco.c \
		data.c \
		google.c \
		ibb.c \
		iq.c \
		jabber.c \
		jutil.c \
		message.c \
		oob.c \
		parser.c \
		ping.c \
		presence.c \
		roster.c \
		si.c \
		xdata.c \
		caps.c \
		adhoccommands.c \
		pep.c \
		useravatar.c \
		usermood.c \
		usernick.c \
		usertune.c \
		libxmpp.c \
		$(NULL)

include $(srcdir)/../prpl-rules.mk
