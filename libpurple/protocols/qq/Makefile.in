DEPTH		= ../../../..
topsrcdir	= @top_srcdir@
srcdir		= @srcdir@
VPATH		= @srcdir@
PROTOCOL	= qq

include $(srcdir)/../prpl.mk

DEFINES += -DQQ_BUDDY_ICON_DIR=\"/dev/null\"

CSRCS		= \
		buddy_info.c \
		buddy_list.c \
		buddy_memo.c \
		buddy_opt.c \
		char_conv.c \
		file_trans.c \
		group.c \
		group_internal.c \
		group_im.c \
		group_info.c \
		group_join.c \
		group_opt.c \
		im.c \
		packet_parse.c \
		qq_base.c \
		qq.c \
		qq_crypt.c \
		qq_define.c \
		qq_network.c \
		qq_process.c \
		qq_trans.c \
		send_file.c \
		utils.c \
		$(NULL)

include $(srcdir)/../prpl-rules.mk
