SOURCES += [
    'bonjour.c',
    'bonjour_ft.c',
    'buddy.c',
    'jabber.c',
    'mdns_common.c',
    'parser.c',
]

if CONFIG['OS_ARCH'] == 'WINNT' or CONFIG['OS_ARCH'] == 'Darwin':
    # We have Bonjour on both Windows and Mac and libpurple does not include a
    # Mac specific file, but it uses the same API as Windows.
    SOURCES += ['mdns_win32.c']

    if CONFIG['OS_ARCH'] == 'WINNT':
        SOURCES += ['dns_sd_proxy.c']
else:
    # Linux uses libavahi instead of Bonjour.
    SOURCES += ['mdns_avahi.c']

protocol = 'bonjour'

include('../prpl.py')
