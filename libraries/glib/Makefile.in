DEPTH		= ../../..
topsrcdir	= @top_srcdir@
srcdir		= @srcdir@
VPATH		= @srcdir@

include $(DEPTH)/config/autoconf.mk

MODULE		= glib
LIBRARY_NAME	= glib
FORCE_SHARED_LIB= 1
LIB_IS_C_ONLY	= 1
NO_DIST_INSTALL	= 1

VISIBILITY_FLAGS=

DIRS		= \
		libcharset \
		gobject \
		$(NULL)

EXPORTS		= \
		gunicodeprivate.h \
		gunicode.h \
		gunicomp.h \
		gunichartables.h \
		gthreadprivate.h \
		gthread.h \
		gutils.h \
		gstdio.h \
		gscripttable.h \
		gmem.h \
		gprintf.h \
		gmirroringtable.h \
		gpattern.h \
		gmacros.h \
		gprintfint.h \
		glibintl.h \
		glib.h \
		gdir.h \
		gdebug.h \
		gdatasetprivate.h \
		galias.h \
		gqsort.h \
		garray.h \
		gmessages.h \
		gstrfuncs.h \
		gthreadpool.h \
		gtimer.h \
		gtree.h \
		gtypes.h \
		gstring.h \
		gurifuncs.h \
		gslist.h \
		gshell.h \
		gsequence.h \
		gscanner.h \
		grel.h \
		gregex.h \
		grand.h \
		gmarkup.h \
		gmain.h \
		gqueue.h \
		goption.h \
		gnode.h \
		glist.h \
		gkeyfile.h \
		gfileutils.h \
		gerror.h \
		gmappedfile.h \
		gdate.h \
		gdataset.h \
		gconvert.h \
		gcompletion.h \
		gcache.h \
		gquark.h \
		gchecksum.h \
		gbookmarkfile.h \
		gbase64.h \
		gbacktrace.h \
		gatomic.h \
		gasyncqueue.h \
		galloca.h \
		ghash.h \
		gprimes.h \
		ghook.h \
		giochannel.h \
		gtestutils.h \
		gspawn.h \
		gslice.h \
		gunidecomp.h \
		config.h \
		glibconfig.h \
		gmodule.h \
		gmoduleconf.h \
		glib-object.h \
		$(NULL)

CSRCS		= \
		garray.c \
		gatomic.c \
		gconvert.c \
		gdataset.c \
		gdir.c \
		gerror.c \
		gfileutils.c \
		ghash.c \
		glist.c \
		gmain.c \
		gmarkup.c \
		gmem.c \
		gmessages.c \
		gpattern.c \
		gprimes.c \
		gqsort.c \
		gqueue.c \
		gshell.c \
		gslice.c \
		gslist.c \
		gstdio.c \
		gstrfuncs.c \
		gstring.c \
		gthread.c \
		guniprop.c \
		gutf8.c \
		gunicollate.c \
		gunidecomp.c \
		gutils.c \
		gprintf.c \
		gspawn.c \
		grand.c \
		libcharset/localcharset.c \
		gmodule.c \
		gscanner.c \
		$(NULL)

EXTRA_LIBS	+= -liconv

include $(topsrcdir)/config/rules.mk

libs:: $(SHARED_LIBRARY)
ifneq (,$(filter OS2 WINNT WINCE,$(OS_ARCH)))
	$(INSTALL) $(IFLAGS2) $(IMPORT_LIBRARY) $(DIST)/lib
else
	$(INSTALL) $(IFLAGS2) $(SHARED_LIBRARY) $(DIST)/lib
endif
	$(INSTALL) $(IFLAGS2) $(SHARED_LIBRARY) $(FINAL_TARGET)/libraries

export:: $(EXPORTS) $(PUBLIC)
	$(INSTALL) $(IFLAGS1) $^
