DEPTH		= ../../..
topsrcdir	= @top_srcdir@
srcdir		= @srcdir@
VPATH		= @srcdir@

include $(DEPTH)/config/autoconf.mk

MODULE		= glib
EXPORTS_NAMESPACES= glib gobject
LIBRARY_NAME	= glib
FORCE_STATIC_LIB= 1
LIB_IS_C_ONLY	= 1
# NO_DIST_INSTALL	= 1

VISIBILITY_FLAGS=

ifeq ($(OS_ARCH),WINNT)
DEFINES		+= -DDISABLE_VISIBILITY -DGLIB_COMPILATION
DSO_LDOPTS	+= -DEF:glib.def
endif
ifeq ($(OS_ARCH),WINCE)
DEFINES		+= -DDISABLE_VISIBILITY -DGLIB_COMPILATION
DSO_LDOPTS	+= -DEF:$(srcdir)/glib-wince.def
endif

DEFINES		+= -DGOBJECT_COMPILATION

EXPORTS_glib	= \
		gunicodeprivate.h \
		gunicode.h \
		gunicomp.h \
		gunichartables.h \
		gthreadprivate.h \
		gthread.h \
		gutils.h \
		gstdio.h \
		gscripttable.h \
		gmem.h \
		gprintf.h \
		gmirroringtable.h \
		gpattern.h \
		gmacros.h \
		gprintfint.h \
		glibintl.h \
		glib.h \
		gdir.h \
		gdebug.h \
		gdatasetprivate.h \
		galias.h \
		gqsort.h \
		garray.h \
		gmessages.h \
		gstrfuncs.h \
		gthreadpool.h \
		gtimer.h \
		gtree.h \
		gtypes.h \
		gstring.h \
		gurifuncs.h \
		gslist.h \
		gshell.h \
		gsequence.h \
		gscanner.h \
		grel.h \
		gregex.h \
		grand.h \
		gmarkup.h \
		gmain.h \
		gqueue.h \
		goption.h \
		gnode.h \
		glist.h \
		gkeyfile.h \
		gfileutils.h \
		gerror.h \
		gmappedfile.h \
		gdataset.h \
		gconvert.h \
		gcompletion.h \
		gcache.h \
		gquark.h \
		gchecksum.h \
		gbookmarkfile.h \
		gbase64.h \
		gbacktrace.h \
		gatomic.h \
		gasyncqueue.h \
		galloca.h \
		ghash.h \
		gprimes.h \
		ghook.h \
		giochannel.h \
		gtestutils.h \
		gslice.h \
		gunidecomp.h \
		config.h \
		glibconfig.h \
		glib-object.h \
		$(NULL)

ifneq (,$(filter WINNT WINCE,$(OS_ARCH)))
EXPORTS_glib	+= \
		gwin32.h \
		dirent-win32.h \
		$(NULL)
endif

ifeq ($(OS_ARCH),WINCE)
EXPORTS_glib	+= \
		wince.h \
		wince-stat.h \
		$(NULL)
endif

EXPORTS_gobject = \
		gobject/gboxed.h		\
		gobject/gclosure.h		\
		gobject/genums.h		\
		gobject/gobject.h		\
		gobject/gobjectalias.h		\
		gobject/gparam.h		\
		gobject/gparamspecs.h		\
		gobject/gsignal.h		\
		gobject/gsourceclosure.h	\
		gobject/gtype.h			\
		gobject/gtypemodule.h		\
		gobject/gtypeplugin.h		\
		gobject/gvalue.h		\
		gobject/gvaluearray.h		\
		gobject/gvaluecollector.h	\
		gobject/gvaluetypes.h		\
		gobject/gobjectnotifyqueue.c	\
		gobject/gmarshal.h		\
		$(NULL)

CSRCS		= \
		garray.c \
		gatomic.c \
		gconvert.c \
		gbase64.c \
		gdataset.c \
		gdir.c \
		gerror.c \
		gfileutils.c \
		ghash.c \
		glist.c \
		gmain.c \
		gmarkup.c \
		gmem.c \
		gmessages.c \
		gpattern.c \
		gprimes.c \
		gqsort.c \
		gqueue.c \
		gshell.c \
		gslice.c \
		gslist.c \
		gstdio.c \
		gstrfuncs.c \
		gstring.c \
		gthread.c \
		guniprop.c \
		gutf8.c \
		gunicollate.c \
		gunidecomp.c \
		gutils.c \
		gprintf.c \
		grand.c \
		libcharset/localcharset.c \
		gobject/gboxed.c		\
		gobject/gclosure.c		\
		gobject/genums.c		\
		gobject/gobject.c		\
		gobject/gparam.c		\
		gobject/gparamspecs.c		\
		gobject/gsignal.c		\
		gobject/gtype.c			\
		gobject/gtypemodule.c		\
		gobject/gtypeplugin.c		\
		gobject/gvalue.c		\
		gobject/gvaluearray.c		\
		gobject/gvaluetransform.c	\
		gobject/gvaluetypes.c		\
		ghook.c				\
		gscanner.c \
		$(NULL)
#		gobject/gmarshal.c		\
#		gobject/gsourceclosure.c	\
#		gobject/gobjectaliasdef.c	\

ifneq (,$(filter WINNT WINCE,$(OS_ARCH)))
CSRCS		+= \
		gwin32.c \
		wdirent.c \
		gnulib/asnprintf.c \
		gnulib/printf-args.c \
		gnulib/printf-parse.c \
		gnulib/printf.c \
		gnulib/vasnprintf.c \
		gthread-impl.c \
		$(NULL)
endif

ifeq ($(OS_ARCH),WINCE)
CSRCS		+= \
		wince.c \
		$(NULL)
endif


ifeq ($(OS_ARCH),WINNT)
EXTRA_LIBS	+= shell32.lib ws2_32.lib ole32.lib
else
ifeq ($(OS_ARCH),WINCE)
EXTRA_LIBS	+= ole32.lib ws2.lib
else
EXTRA_LIBS	+= -liconv
endif
endif

include $(topsrcdir)/config/rules.mk

export::
	mkdir -p libcharset gobject
ifneq (,$(filter WINNT WINCE,$(OS_ARCH)))
	mkdir -p gnulib
endif

ifneq (,$(filter WINNT WINCE,$(OS_ARCH)))
libs:: glib.def

glib.def: $(srcdir)/glib.symbols $(srcdir)/gobject.symbols $(GLOBAL_DEPS)
	echo EXPORTS > glib.def
	$(CPP) -DINCLUDE_VARIABLES -DINCLUDE_INTERNAL_SYMBOLS -DG_OS_WIN32 -DALL_FILES $(srcdir)/glib.symbols | \
            sed -e '/#/d' -e '/^$$/d' -e 's/^/	/' -e 's/G_GNUC_[^ ]*//g' >> glib.def
	$(CPP) -DINCLUDE_VARIABLES -DG_OS_WIN32 -DALL_FILES $(srcdir)/gobject.symbols | \
            sed -e '/#/d' -e '/^$$/d' -e 's/^/	/' -e 's/G_GNUC_[^ ]*//g' >> glib.def
endif
